<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_gray"
    android:fitsSystemWindows="true">

    <!-- App Bar -->
    <include
        android:id="@+id/topBar"
        layout="@layout/layout_app_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/llPoweredBy">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="@dimen/_16sdp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="@dimen/_2sdp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="@dimen/_20sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Logo URL Details"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_blue"
                        android:layout_marginBottom="@dimen/_16sdp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/urlInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:hint="https://example.com"
                        app:startIconDrawable="@drawable/ic_business"
                        app:startIconTint="@color/brand_blue"
                        app:boxStrokeColor="@color/brand_blue"
                        app:hintTextColor="@color/brand_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/urlInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textSize="@dimen/_13ssp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_16sdp"
                        android:text="Enter the URL and Tap Logo to write."
                        android:textColor="@color/gray_text"
                        android:textSize="@dimen/_10ssp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="@dimen/_16sdp" />

                    <LinearLayout
                        android:id="@+id/writeStatusContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/statusMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ready to write"
                            android:textColor="@color/gray_text"
                            android:textSize="@dimen/_12ssp"
                            android:gravity="center"
                            android:layout_marginBottom="@dimen/_12sdp" />

                        <ProgressBar
                            android:id="@+id/scanProgress"
                            android:layout_width="@dimen/_40sdp"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="@dimen/_12sdp"
                            android:visibility="gone"
                            android:indeterminateTint="@color/brand_blue" />

                        <TextView
                            android:id="@+id/tapCardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="TAP CARD NOW..."
                            android:textStyle="bold"
                            android:textSize="@dimen/_15ssp"
                            android:textColor="@color/brand_blue"
                            android:visibility="gone"
                            android:layout_marginBottom="@dimen/_16sdp" />

                        <Button
                            android:id="@+id/startScanButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_48sdp"
                            android:text="Start Scan &amp; Write"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            app:cornerRadius="@dimen/_8sdp"
                            app:backgroundTint="@color/brand_blue" />

                        <Button
                            android:id="@+id/stopScanButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_48sdp"
                            android:text="Stop Scanning"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:visibility="gone"
                            app:cornerRadius="@dimen/_8sdp"
                            app:backgroundTint="@color/error_red" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Powered by DeviSoft -->
    <LinearLayout
        android:id="@+id/llPoweredBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by "
            android:textColor="@color/gray_text"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Devi"
            android:textColor="@color/devisoft_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Soft"
            android:textColor="@color/devisoft_orange"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
